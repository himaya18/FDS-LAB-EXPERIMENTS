import pandas as pd
import matplotlib.pyplot as plt
from statsmodels.tsa.seasonal import seasonal_decompose

# Load dataset
data = pd.read_csv(
    'website_traffic.csv',
    parse_dates=['Date'],
    index_col='Date'
)

# Sort data by date
data = data.sort_index()

# Time Series Decomposition
decomposition = seasonal_decompose(
    data['Page_Views'],
    model='additive',
    period=7
)

decomposition.plot()
plt.show()

# Moving Average
data['Page_Views_MA'] = data['Page_Views'].rolling(
    window=30
).mean()

data[['Page_Views', 'Page_Views_MA']].plot(
    figsize=(10, 6)
)
plt.title('Page Views with Moving Average')
plt.xlabel('Date')
plt.ylabel('Page Views')
plt.show()

# Anomaly Detection
mean_value = data['Page_Views'].mean()
std_value = data['Page_Views'].std()

if std_value != 0:
    data['Page_Views_Z'] = (
        (data['Page_Views'] - mean_value) / std_value
    )
else:
    data['Page_Views_Z'] = 0

anomalies = data[data['Page_Views_Z'].abs() > 3]

# Plot anomalies
plt.figure(figsize=(10, 6))
plt.plot(
    data.index,
    data['Page_Views'],
    label='Page Views'
)
plt.scatter(
    anomalies.index,
    anomalies['Page_Views'],
    color='red',
    label='Anomalies'
)
plt.title('Website Traffic Anomaly Detection')
plt.xlabel('Date')
plt.ylabel('Page Views')
plt.legend()
plt.tight_layout()
plt.show()
